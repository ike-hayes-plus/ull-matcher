{
  "_comment": [
    "Floors for HA/cluster benchmark reports (binary ingress, REST HA).",
    "Validated when reports exist under target/benchmark/3.0-full/ via",
    "scripts/ops/check-ha-benchmark-floor.sh. Values sit well below the",
    "reference machine in benchmark-baseline.md to tolerate lab variance."
  ],
  "scenarios": {
    "grpc-1p1s-binary": {
      "reportFile": "grpc-1p1s.json",
      "atLeast": {
        "acceptedCommandsPerSecond": 120000.0,
        "replicationCommittedSubmissionsPerSecond": 110000.0
